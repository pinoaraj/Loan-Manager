# Loan Manager Server - Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: JWT Secret for authentication (minimum 32 characters)
# Generate with: openssl rand -base64 64
# Or in Node.js: require('crypto').randomBytes(64).toString('base64')
JWT_SECRET=

# Database path (SQLite)
DATABASE_URL="file:./dev.db"

# Server configuration
PORT=3001
NODE_ENV=development

# CORS allowed origins (comma-separated)
# Development: http://localhost:5173
# Production: Add your domain(s)
CORS_ORIGINS=http://localhost:5173,app://localhost

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# SECURITY NOTES:
# - Never commit .env to git (already in .gitignore)
# - Use different JWT_SECRET for production
# - Generate JWT_SECRET with at least 64 random bytes
# - Rotate JWT_SECRET periodically in production
